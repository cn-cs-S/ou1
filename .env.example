# Copy this file to .env and fill values locally.
# Never commit .env.

OKX_API_BASE=https://www.okx.com

# Default mode: public live market data plus a local editable test account.
# No private OKX API key is required and no orders are sent.
OKX_ACCOUNT_SOURCE=test
TEST_ACCOUNT_INITIAL_USDT=100000
# Used only when the authenticated OKX fee-rate endpoint is unavailable.
OKX_SPOT_TAKER_FEE_RATE=0.001
OKX_SWAP_TAKER_FEE_RATE=0.0005

# Future optional mode: read balances and positions from a real OKX account.
# This mode is read-only in this project; use an API key with read permission only.
# OKX_ACCOUNT_SOURCE=live-readonly
# OKX_API_KEY=your_read_only_api_key
# OKX_API_SECRET=your_read_only_secret_key
# OKX_API_PASSPHRASE=your_read_only_passphrase

# Official OKX CLI/MCP aliases are also supported for live-readonly mode:
# OKX_SECRET_KEY=your_read_only_secret_key
# OKX_PASSPHRASE=your_read_only_passphrase

# Automated adjustments are enabled explicitly in the UI and can only change local test accounts.
